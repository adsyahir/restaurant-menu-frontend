# systemd unit for the Nuxt frontend (nitro node server).
# Install:  sudo cp deploy/rms-frontend.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now rms-frontend
# Logs:     journalctl -u rms-frontend -f
[Unit]
Description=RMS Frontend (Nuxt nitro node server)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/rms-frontend
ExecStart=/usr/bin/node .output/server/index.mjs

# Bind 0.0.0.0 (NOT 127.0.0.1) so the k3s Traefik pod can reach it via the
# EndpointSlice bridge (k8s/bridge.yaml).
Environment=NODE_ENV=production
Environment=NITRO_HOST=0.0.0.0
Environment=NITRO_PORT=3000

# Point the browser at the backend's public API.
Environment=NUXT_PUBLIC_API_BASE=https://api.yourdomain.com

Restart=always
RestartSec=3

# Light hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
